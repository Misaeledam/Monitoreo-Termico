# Agregar al final de /boot/firmware/config.txt (Raspberry Pi OS Bookworm) y reiniciar.

# Bus I2C 1 (GPIO2/GPIO3, pines 3 y 5) para la sonda de ENTRADA, a 50 kHz
# para tolerar mejor el cable largo.
dtparam=i2c_arm=on
dtparam=i2c_arm_baudrate=50000

# Bus I2C 4 en GPIO8/GPIO9 (pines 24 y 21) para la sonda de SALIDA, también a 50 kHz.
# Este bus no tiene resistencias pull-up en la placa: las pone el módulo SHT31
# o se agregan de 4,7 kΩ a 3V3.
dtoverlay=i2c4,pins_8_9,baudrate=50000
