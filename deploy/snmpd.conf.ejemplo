# Fragmento para /etc/snmp/snmpd.conf en la Raspberry Pi.
# 1) Crear el usuario SNMPv3 (con snmpd detenido):
#      sudo systemctl stop snmpd
#      sudo net-snmp-create-v3-user -ro -a SHA -A 'CLAVE_AUTH_LARGA' -x AES -X 'CLAVE_PRIV_LARGA' monitoreo
#    Eso agrega la línea "rouser monitoreo" a /usr/share/snmp/snmpd.conf.
# 2) Agregar lo siguiente a /etc/snmp/snmpd.conf y reiniciar snmpd.

# Solo SNMPv3: comentar o borrar cualquier línea rocommunity/rwcommunity del archivo.

# Escuchar en todas las interfaces (Debian escucha solo en 127.0.0.1 por defecto).
agentaddress udp:161

# Métricas del bastidor por la extensión pass_persist (deploy/monitoreo-snmp).
pass_persist .1.3.6.1.4.1.8072.9999.9999.1 /usr/local/bin/monitoreo-snmp
