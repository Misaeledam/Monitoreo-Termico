# Copiar a /etc/monitoreo/secretos.env con permisos 640 (root:monitoreo).
# Nunca subir el archivo real al repositorio.
MONITOREO_SMTP_PASS=
MONITOREO_TELEGRAM_TOKEN=
MONITOREO_SNMP_AUTH=
MONITOREO_SNMP_PRIV=
# Generar con: /opt/monitoreo/venv/bin/python -m monitoreo hash-contrasena
MONITOREO_PANEL_HASH=
